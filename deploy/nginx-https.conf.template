# Bản HTTPS của service `web` (bật bằng `docker-compose.https.yml`). Image nginx thay `${VS_HTTPS_PORT}` và
# `${VS_HSTS_MAX_AGE}` bằng biến môi trường lúc khởi động rồi ghi ra /etc/nginx/conf.d/default.conf; chỉ biến môi
# trường có thật bị thay, nên các biến của nginx như `$host` giữ nguyên.

include /etc/nginx/vietstrain/http.conf;

# Cổng HTTP chỉ còn chuyển hướng: không trang nào, không request API nào được phục vụ qua kết nối không mã hoá.
server {
    listen 80;
    server_name _;
    server_tokens off;
    return 301 https://$host:${VS_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/vietstrain.crt;
    ssl_certificate_key /etc/nginx/certs/vietstrain.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;

    # Báo trình duyệt chỉ dùng HTTPS cho tên này trong `max-age` giây. Trên máy phát triển để 0: HSTS áp cho mọi cổng
    # của một tên, nên nhớ HTTPS cho `localhost` sẽ làm hỏng các trang HTTP khác trên máy. Trên server thật có tên
    # miền, đặt VS_HSTS_MAX_AGE=31536000. Cùng cấp `server` với các `add_header` trong site.conf, nên đi kèm mọi
    # câu trả lời.
    add_header Strict-Transport-Security "max-age=${VS_HSTS_MAX_AGE}" always;

    include /etc/nginx/vietstrain/site.conf;
}
